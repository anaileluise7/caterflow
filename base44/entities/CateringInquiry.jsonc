{
  "name": "CateringInquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "title": "Event Date"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "Wedding",
        "Corporate",
        "Birthday",
        "Private Dinner",
        "Cocktail Reception",
        "Other"
      ],
      "title": "Event Type"
    },
    "guest_count": {
      "type": "number",
      "title": "Guest Count"
    },
    "venue": {
      "type": "string",
      "title": "Venue / Location"
    },
    "budget_per_head": {
      "type": "string",
      "title": "Budget Per Head"
    },
    "dietary_requirements": {
      "type": "string",
      "title": "Dietary Requirements"
    },
    "additional_notes": {
      "type": "string",
      "title": "Additional Notes"
    },
    "tasting_notes": {
      "type": "string",
      "title": "Tasting Notes"
    },
    "special_requests": {
      "type": "string",
      "title": "Special Client Requests"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "Instagram",
        "Facebook",
        "Google",
        "Word of Mouth",
        "Referral",
        "Wedding Fair",
        "Other"
      ],
      "title": "Lead Source"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "title": "Follow-up Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "New Inquiry",
        "Quoted",
        "Tasting Booked",
        "Confirmed",
        "Invoiced",
        "Paid",
        "Completed",
        "Declined"
      ],
      "default": "New Inquiry",
      "title": "Status"
    },
    "proposal": {
      "type": "string",
      "title": "Generated Proposal"
    },
    "share_token": {
      "type": "string",
      "title": "Share Token"
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Equipment Checklist"
    },
    "files": {
      "type": "array",
      "title": "Event Files",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "total_quoted": {
      "type": "number",
      "title": "Total Quoted Amount"
    },
    "deposit_amount": {
      "type": "number",
      "title": "Deposit Amount"
    },
    "deposit_due_date": {
      "type": "string",
      "format": "date",
      "title": "Deposit Due Date"
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false,
      "title": "Deposit Paid"
    },
    "balance_amount": {
      "type": "number",
      "title": "Balance Amount"
    },
    "balance_due_date": {
      "type": "string",
      "format": "date",
      "title": "Balance Due Date"
    },
    "balance_paid": {
      "type": "boolean",
      "default": false,
      "title": "Balance Paid"
    }
  },
  "required": [
    "name",
    "event_date",
    "event_type",
    "guest_count"
  ]
}